# ═══ BLACKROCK ULTRA SCREENER — Environment Variables ═══
# Copiez ce fichier vers .env et remplissez vos valeurs.
# ⚠️ Ne JAMAIS committer le fichier .env

# Token du Bot Telegram (obtenu via @BotFather)
TELEGRAM_BOT_TOKEN=votre_token_ici

# Chat ID Telegram pour recevoir les rapports et les tests d'envoi.
# Pour obtenir votre chat_id :
#   1. Envoyez /start à votre bot
#   2. Ouvrez https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Cherchez "chat":{"id": XXXXXXX}  — c'est votre TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=votre_chat_id_ici
